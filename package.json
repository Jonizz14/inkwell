{
  "name": "inkwell",
  "productName": "365 Articles Reader",
  "version": "1.0.0",
  "description": "Offline desktop reader for PDF articles: highlights, vocabulary, focus mode, paragraph notes and reading stats",
  "main": "src/main.js",
  "author": "Javohir",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "test": "node test/extract.test.mjs",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "icon": "python3 scripts/make_icon.py",
    "install:mac": "bash scripts/install-mac.sh",
    "build:ocr": "mkdir -p src/bin && swiftc -O tools/vision-ocr.swift -o src/bin/vision-ocr",
    "build:read": "mkdir -p src/bin && swiftc -O tools/read-along.swift -o src/bin/read-along",
    "build:haptic": "bash scripts/build-haptic.sh",
    "build:mac-tools": "npm run build:ocr && npm run build:read && npm run build:haptic && npm run build:notch",
    "reextract": "node scripts/reextract.mjs --apply",
    "web:content": "node scripts/web-content.mjs",
    "web:build": "node scripts/build-web.mjs",
    "web:dev": "node scripts/build-web.mjs && npx -y serve web/dist -l 5173",
    "web:deploy": "node scripts/build-web.mjs && cd web/dist && npx -y vercel@latest deploy --prod --yes",
    "build:notch": "bash scripts/build-notch.sh"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "5.4.296",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "uz.javohir.articles365",
    "productName": "Inkwell",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!web/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Inkwell listens while you read aloud, to follow the text.",
        "NSSpeechRecognitionUsageDescription": "Speech is recognised on this Mac to follow your reading aloud."
      }
    },
    "dmg": {
      "title": "Inkwell"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Inkwell-Setup-${version}.${ext}",
      "createDesktopShortcut": "always",
      "shortcutName": "Inkwell"
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonizz14/inkwell.git"
  },
  "homepage": "https://github.com/Jonizz14/inkwell"
}
